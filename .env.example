# Server Configuration
PORT=4444

# Rate Limiting Configuration
MAX_BUNDLES_PER_SECOND=10

# Environment
NODE_ENV=development

# ---------------------------------------------------------------------------
# Execution provider (transaction landing)
# ---------------------------------------------------------------------------
# Primary provider: fury | helius-sender | jito | jupiter
EXECUTION_PROVIDER=helius-sender
# Ordered fallbacks tried on failure (comma-separated). Fury preserved as fallback.
EXECUTION_FALLBACKS=jito,fury

# Helius Sender (https://www.helius.dev/docs/sending-transactions/sender)
HELIUS_SENDER_URL=https://sender.helius-rpc.com/fast
# Optional for Sender. Provide your own key; do NOT commit it.
HELIUS_API_KEY=

# Jito block engine (https://docs.jito.wtf)
JITO_ENDPOINT=https://mainnet.block-engine.jito.wtf

# Jupiter tx.jup.ag (https://dev.jup.ag/docs/transaction/submit) - per-tx landing.
# Requires the signed tx to already carry a Jupiter tip instruction, or it is rejected.
JUPITER_ENDPOINT=https://tx.jup.ag
# Required by tx.jup.ag. Provide your own key; do NOT commit it.
JUPITER_API_KEY=

# Fury Bot (optional fallback). Provide your own key; do NOT commit it.
FURY_API_URL=https://de.fury.bot
FURY_API_KEY=

# ---------------------------------------------------------------------------
# Live token feed (Creations / Migrations) - Solana Tracker Data API
# https://docs.solanatracker.io/data-api/search/token-search
# ---------------------------------------------------------------------------
SOLANA_TRACKER_BASE_URL=https://data.solanatracker.io
# Required. Provide your own key; do NOT commit it.
SOLANA_TRACKER_API_KEY=
# Poll interval in ms. Default (15 min) keeps 3 polled endpoints under the
# free tier's 10,000 requests/month cap. Lower this only on a paid plan.
SOLANA_TRACKER_POLL_INTERVAL_MS=900000

# ---------------------------------------------------------------------------
# Instructions:
# 1. Copy this file to .env  (.env is git-ignored — never commit it)
# 2. Fill in your OWN keys. This file must contain NO real secrets.
# 3. Keep API keys and private keys out of version control.
